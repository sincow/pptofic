
RewriteEngine On

# Si estás en un subdirectorio, descomenta y ajusta la siguiente línea:
# RewriteBase /

# Redirigir todo a index.php (Front Controller)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Proteger archivos sensibles
<Files ~ "\.(env|json|config.js|md|gitignore|gitattributes|lock)$">
    Order allow,deny
    Deny from all
</Files>

# Proteger directorios
<DirectoryMatch "^(app|config|temp)">
    Order allow,deny
    Deny from all
</DirectoryMatch>

# Comprimir salida
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

# Configuración de PHP para hosting compartido
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>



